# ============================================
# AI-WAREHOUSE — 开发环境 配置模板
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# --- 通用 ---
ENV=dev
LOG_LEVEL=debug
TZ=Asia/Shanghai

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_warehouse
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_dev

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530

# --- MinIO (对象存储) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_dev
MINIO_SECRET_KEY=change_me_dev

# --- NVIDIA GPU ---
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- AI 模型 Serving ---
MODEL_SERVER_ENDPOINT=http://localhost:8000
INFERENCE_ENGINE=vllm

# --- 监控 ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
