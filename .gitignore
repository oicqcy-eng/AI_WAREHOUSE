# AI-WAREHOUSE v4
*.key *.pem *.p12 *.pfx *.cert *.crt *.csr
kubeconfig* !kubeconfig.example
.env .env.* !.env.example
.terraform/ *.tfstate *.tfvars !*.example.tfvars
*vault* *.vault
*.log /var/log/ logs/
.DS_Store Thumbs.db *.swp *~ .vscode/ .idea/ *.iml
tmp/ temp/ *.bak *.old
*.iso *.dmg *.bin model-weights/ *.pt *.pth *.onnx *.gguf
**/docker/data/ **/docker/volumes/

# 客户原始资料不入库（大文件+敏感数据，仅存本地 inbox/ 与项目 input/）
# 仓库只沉淀整理成果(MD 文档)，原件保留在本地
*.xlsx
*.xls
*.pptx
*.ppt
*.jpeg
*.jpg
*.png
*.gif
*.bmp
*.tiff
*.doc
*.docx
*.pdf
# 客户数据字典/设计文档等大体积 html 原件不入库（仅存本地 inbox/，仓库只沉淀解析 MD）
delivery/inbox/*.html
